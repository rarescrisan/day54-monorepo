{
  "name": "web-skeleton",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{apps,packages}/**/*.{js,mjs,json,css}": [
      "prettier --write"
    ],
    "*.{js,mjs,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "turbo": "2.10.6",
    "typescript": "5.9.3"
  }
}
